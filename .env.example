# Required for local or production database operations.
DATABASE_URL=postgresql://opendq:opendq@localhost:5432/opendq

APP_ENV=development
LOG_LEVEL=INFO

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
USGS_BASE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson

AI_COPILOT_ENABLED=false
AI_ALLOWED_DATA_CLASSIFICATION=PUBLIC_ONLY
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=8
AI_MAX_INPUT_TOKENS=3000
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_CALLS_PER_RUN=3
AI_MAX_CALLS_PER_INCIDENT=1
